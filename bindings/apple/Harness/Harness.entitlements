<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator-only, ad-hoc signed. No App Group: the v1 database lives in the app's own
	     container, and the harness has no extension. -->
	<key>application-identifier</key>
	<string>org.ramflux.harness</string>
	<key>keychain-access-groups</key>
	<array>
		<string>org.ramflux.harness</string>
	</array>
</dict>
</plist>
