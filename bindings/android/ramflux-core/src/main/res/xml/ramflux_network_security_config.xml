<!--
    Platform HTTP stays strict: no cleartext, system trust anchors only. This file does not
    pin the gateway session; the Rust core verifies that session against the node's own CA.
    There is no "trust this certificate anyway" path here or anywhere else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
