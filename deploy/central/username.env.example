# Reference only. The real files are written by publish-username-pin.py into USERNAME_DIR:
#   witness.env (witness role), center.env (centre role), home.env (home node, pin for homes).
# Role-specific keys: the federation refuses keys that do not belong to its role.
# Witness: RAMFLUX_USERNAME_ROLE=witness, LISTEN_ADDR, WITNESS_DB, RAMFLUX_FEDERATION_NODE_SIGNING_SEED_FILE
# Centre:  RAMFLUX_USERNAME_ROLE=center, PRIMARY_DB
# Both:    RAMFLUX_USERNAME_CENTER_URL|ID|PUBLIC_KEY|TLS_SERVER_NAME|CA_FILE, TRUST_GENERATION,
#          WITNESS_SOCKET, CENTER_UID=10001, WITNESS_UID=10002
RAMFLUX_USERNAME_CENTER_URL=https://HOST:PORT
RAMFLUX_USERNAME_CENTER_ID=username-centre.local
RAMFLUX_USERNAME_CENTER_PUBLIC_KEY=BASE64URL_ED25519_PUBLIC_KEY
RAMFLUX_USERNAME_CENTER_TLS_SERVER_NAME=ramflux-federation
RAMFLUX_USERNAME_TRUST_GENERATION=1
