                {
                  "$ref": "#/$defs/Binding"
                }
              ]
            }
          },
          "required": [
            "columns",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "x-encodedBytes": 256,
      "x-crossFields": "table"
    },
    "chart": {
