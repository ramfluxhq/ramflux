                  "$ref": "#/$defs/Binding"
                }
              ]
            }
          },
          "required": [
            "kind",
            "series"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "x-encodedBytes": 256,
      "x-crossFields": "chart"
    },
    "timeline": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
