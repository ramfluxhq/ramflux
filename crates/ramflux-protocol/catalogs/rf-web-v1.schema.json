                  "$ref": "#/$defs/Binding"
                }
              ]
            }
          },
          "required": [
            "events"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "x-encodedBytes": 256,
      "x-crossFields": "timeline"
    },
    "form": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "const": "rf.form"
        },
        "data": {
          "type": "object",
          "properties": {
            "title": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShortText"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "minItems": 1,
              "maxItems": 4
            },
            "submit": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "title",
            "fields",
            "submit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "x-encodedBytes": 256,
