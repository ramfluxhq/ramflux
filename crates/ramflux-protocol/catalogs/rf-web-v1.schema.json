                {
                  "$ref": "#/$defs/ShortText"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShortText"
                },
                {
                  "$ref": "#/$defs/Binding"
                }
              ]
            },
            "mode": {
              "enum": [
                "text",
