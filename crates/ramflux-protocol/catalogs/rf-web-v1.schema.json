              ]
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "label",
            "value",
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "x-encodedBytes": 256,
      "x-crossFields": "input"
