{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "types": [],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "files": [
    "adapter.ts",
    "worker.ts",
    "env.ts",
    "preview.ts"
  ]
}
